{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["PLATFORM"],
			"outputs": ["build/**", ".svelte-kit/cloudflare/**", ".svelte-kit/output/**", "dist/**"]
		},
		"check": {
			"dependsOn": ["^check"]
		},
		"test": {
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
